# Lister - Directory Listing Application
# Git ignore file

# Environment files
.env
.env.local
.env.production

# Data directory (contains security logs and rate limiting data)
lister/data/

# Log viewer password hash (see lister/log.php)
lister/config/log_viewer.json

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.backup

# Test files (keep in scripts/ but not in root)
/test_*.php
debug.php

# Security test data
security_test_*.json
rate_*.json

# Deployment tracking
lister/.deploy-timestamp